{
  "name": "backend-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.ts --mode=api",
    "start": "bun run src/main.ts --mode=api",
    "test": "bun test",
    "type-check": "bunx tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.14",
    "drizzle-orm": "^0.45.1",
    "elysia": "1.4.25",
    "neverthrow": "^8.2.0",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/parser": "^8.46.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3"
  }
}
