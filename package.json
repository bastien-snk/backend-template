{
    "name": "backend-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --hot src/main.ts --mode=api",
        "start": "bun run src/main.ts --mode=api",
        "test": "bun test",
        "type-check": "bunx tsc --noEmit",
        "lint": "eslint . --ext .ts",
        "format": "prettier --check .",
        "format:write": "prettier --write .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.4.2",
        "@elysiajs/openapi": "^1.4.14",
        "@elysiajs/static": "^1.4.10",
        "drizzle-orm": "^0.45.1",
        "elysia": "1.4.25",
        "json-stable-stringify": "^1.3.0",
        "nats": "^2.29.3",
        "neverthrow": "^8.2.0",
        "pg": "^8.18.0",
        "pg-boss": "^10.1.6",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "uuid": "^13.0.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@types/bun": "^1.3.9",
        "@types/json-stable-stringify": "^1.0.36",
        "@types/pg": "^8.16.0",
        "@typescript-eslint/parser": "^8.46.0",
        "drizzle-kit": "^0.31.9",
        "eslint": "^8.57.1",
        "prettier": "^3.5.3"
    }
}
