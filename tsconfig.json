{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "types": ["bun-types"],
        "strict": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0",
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src", "tests", "drizzle.config.ts"]
}
